# Copy to .env and fill in. NEVER commit .env.
AWS_REGION=us-east-1

# Bedrock model. Must be an inference-profile ID (the bare anthropic.* ID is
# rejected for on-demand throughput). See BUILD_LOG.md.
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Evidence + trust packets. Bucket name must be globally unique; the bootstrap
# script suffixes your account ID automatically if you leave this unset.
S3_BUCKET=

# DynamoDB table prefix -> attest_runs, attest_controls, attest_evidence,
# attest_approvals, attest_audit_log
TABLE_PREFIX=attest

# SES sender + recipient for approval requests. Both must be verified in SES
# while the account is in the sandbox.
SES_FROM=
SES_TO=

# Control tuning. Demo uses 1 so the freshly-seeded key trips the control.
MAX_KEY_AGE_DAYS=90

# Demo resource prefix. Remediation tools refuse to write outside this prefix.
DEMO_PREFIX=attest-demo-
